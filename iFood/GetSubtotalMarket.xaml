            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Builds the market result. The first delivery option is selected by iFood when the checkout page loads,&#xA;' so the totals and the delivery shown here are for that option.&#xA;Dim pt = System.Globalization.CultureInfo.GetCultureInfo(&quot;pt-BR&quot;)&#xA;Dim rx = Function(text As String, pattern As String) As String&#xA;    Dim m = System.Text.RegularExpressions.Regex.Match(If(text, &quot;&quot;), pattern)&#xA;    Return If(m.Success, System.Text.RegularExpressions.Regex.Replace(m.Groups(1).Value, &quot;\s+&quot;, &quot; &quot;).Trim(), &quot;&quot;)&#xA;End Function&#xA;Dim toNumber = Function(value As String) As Decimal&#xA;    If value.StartsWith(&quot;Grátis&quot;, StringComparison.OrdinalIgnoreCase) Then Return 0D&#xA;    Return Decimal.Parse(System.Text.RegularExpressions.Regex.Match(value, &quot;[\d\.]+,\d{2}&quot;).Value, pt)&#xA;End Function&#xA;Const amount As String = &quot;(Grátis|R\$\s?[\d\.]+,\d{2})&quot;&#xA;Dim total = rx(totalsText, &quot;(?&lt;!Sub)Total[\s\S]{0,5}?&quot; &amp; amount)&#xA;If total = &quot;&quot; Then Throw New Exception(&quot;Could not read the total of market '&quot; &amp; marketName &amp; &quot;'. Text read: &quot; &amp; totalsText)&#xA;&#xA;' First delivery card in the carousel text, e.g. &quot;Entrega agendada?Seg, 09:00-11:00R$ 7,99 Entrega agendada?...&quot;&#xA;' (the &quot;?&quot; is the help icon between the type and the date/time).&#xA;Dim delivery As Newtonsoft.Json.Linq.JObject = Nothing&#xA;Dim first = System.Text.RegularExpressions.Regex.Match(System.Text.RegularExpressions.Regex.Replace(If(deliveriesText, &quot;&quot;), &quot;\s+&quot;, &quot; &quot;), &quot;^\s*(?&lt;label&gt;.*?)(?&lt;price&gt;R\$\s?[\d\.]+,\d{2}|Grátis)&quot;)&#xA;If first.Success Then&#xA;    Dim label = first.Groups(&quot;label&quot;).Value.Trim()&#xA;    Dim parts = System.Text.RegularExpressions.Regex.Match(label, &quot;^(?&lt;t&gt;[^?\uFFFD]+?)\s*[?\uFFFD]\s*(?&lt;q&gt;.+)$&quot;)&#xA;    delivery = New Newtonsoft.Json.Linq.JObject(&#xA;        New Newtonsoft.Json.Linq.JProperty(&quot;tipo&quot;, If(parts.Success, parts.Groups(&quot;t&quot;).Value.Trim(), &quot;&quot;)),&#xA;        New Newtonsoft.Json.Linq.JProperty(&quot;quando&quot;, If(parts.Success, parts.Groups(&quot;q&quot;).Value.Trim(), label)),&#xA;        New Newtonsoft.Json.Linq.JProperty(&quot;valor&quot;, first.Groups(&quot;price&quot;).Value.Trim()))&#xA;End If&#xA;&#xA;result = New Newtonsoft.Json.Linq.JObject(&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;mercadoPesquisado&quot;, marketName),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;mercado&quot;, If(String.IsNullOrWhiteSpace(marketTitle), marketName, marketTitle.Trim())),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;status&quot;, &quot;ok&quot;),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;faltaParaEntregaGratis&quot;, If(freeDelivery, &quot;&quot;)),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;subtotal&quot;, rx(totalsText, &quot;Subtotal[\s\S]{0,5}?&quot; &amp; amount)),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;taxaServico&quot;, rx(totalsText, &quot;Taxa de serviço[\s\S]{0,5}?&quot; &amp; amount)),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;taxaEntrega&quot;, rx(totalsText, &quot;Taxa de entrega[\s\S]{0,5}?&quot; &amp; amount)),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;total&quot;, total),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;totalNumero&quot;, toNumber(total)),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;entrega&quot;, delivery),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;pedidoMinimo&quot;, If(System.Text.RegularExpressions.Regex.Match(If(minimumText, &quot;&quot;), &quot;R\$\s?[\d\.]+,\d{2}&quot;).Success, System.Text.RegularExpressions.Regex.Replace(System.Text.RegularExpressions.Regex.Match(minimumText, &quot;R\$\s?[\d\.]+,\d{2}&quot;).Value, &quot;\s+&quot;, &quot; &quot;), System.Text.RegularExpressions.Regex.Replace(If(minimumText, &quot;&quot;), &quot;\s+&quot;, &quot; &quot;).Trim())),&#xA;    New Newtonsoft.Json.Linq.JProperty(&quot;itensNaoEncontrados&quot;, New Newtonsoft.Json.Linq.JArray(If(missingItems, New List(Of String)).ToArray())))" DisplayName="Invoke Code – Build market result" sap:VirtualizedContainerService.HintSize="651.2,400.8" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
