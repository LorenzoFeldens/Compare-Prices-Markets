  <Sequence DisplayName="InitSettings" sap2010:Annotation.AnnotationText="Reads Data\Config.xlsx: the Settings sheet (Name/Value) and the Orchestrator assets listed in the Assets sheet (Name/Asset/Folder). Fails if any required key is missing or empty.">
    <Sequence.Variables>
      <Variable x:TypeArguments="sdata:DataTable" Name="settingsDataTable" />
      <Variable x:TypeArguments="sdata:DataTable" Name="assetsDataTable" />
      <Variable x:TypeArguments="x:String" Name="assetValue" />
      <Variable x:TypeArguments="x:String" Name="missingKeys" />
    </Sequence.Variables>
    <ui:ReadRange AddHeaders="True" DataTable="[settingsDataTable]" DisplayName="Read – Settings sheet" Range="[&quot;&quot;]" SheetName="[&quot;Settings&quot;]" WorkbookPath="[in_ConfigFile]">
      <ui:ReadRange.Password>
        <InArgument x:TypeArguments="x:String" />
      </ui:ReadRange.Password>
    </ui:ReadRange>
    <Assign DisplayName="Assign – Settings to dictionary">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">[out_Config]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">[settingsDataTable.AsEnumerable().Where(Function(r) Not String.IsNullOrWhiteSpace(r("Name").ToString)).ToDictionary(Function(r) r("Name").ToString.Trim, Function(r) r("Value"), StringComparer.OrdinalIgnoreCase)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ReadRange AddHeaders="True" DataTable="[assetsDataTable]" DisplayName="Read – Assets sheet" Range="[&quot;&quot;]" SheetName="[&quot;Assets&quot;]" WorkbookPath="[in_ConfigFile]">
      <ui:ReadRange.Password>
        <InArgument x:TypeArguments="x:String" />
      </ui:ReadRange.Password>
    </ui:ReadRange>
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[assetsDataTable]" DisplayName="For Each Asset">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sdata:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sdata:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Load asset">
            <If Condition="[Not String.IsNullOrWhiteSpace(row(&quot;Name&quot;).ToString)]" DisplayName="If – Row has an asset name">
              <If.Then>
                <Sequence DisplayName="Then">
                  <ui:GetRobotAsset TimeoutMS="{x:Null}" AssetName="[row(&quot;Asset&quot;).ToString.Trim]" CacheStrategy="None" DisplayName="Get Asset – Orchestrator value" FolderPath="[If(String.IsNullOrWhiteSpace(row(&quot;Folder&quot;).ToString), Nothing, row(&quot;Folder&quot;).ToString.Trim)]">
                    <ui:GetRobotAsset.Value>
                      <OutArgument x:TypeArguments="x:String">[assetValue]</OutArgument>
                    </ui:GetRobotAsset.Value>
                  </ui:GetRobotAsset>
                  <Assign DisplayName="Assign – Asset to dictionary">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Object">[out_Config(row("Name").ToString.Trim)]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Object">[assetValue]</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <Assign DisplayName="Assign – Missing settings">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[missingKeys]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(", ", {"iFoodURL", "ProductsSheetName", "ProductsSheetRange", "ProductsItemColumn", "ProductsAmountColumn", "MarketsSheetName", "MarketsSheetRange", "MarketsMarketColumn", "ClaudeModel", "ClaudeMaxTokens", "EmailPromptFile", "EmailSubject", "SheetURL", "SendTo"}.Where(Function(k) Not out_Config.ContainsKey(k) OrElse String.IsNullOrWhiteSpace(Convert.ToString(out_Config(k)))))]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[missingKeys &lt;&gt; String.Empty]" DisplayName="If – Settings are missing">
      <If.Then>
        <Sequence DisplayName="Then">
          <Throw DisplayName="Throw – Missing settings" Exception="[New Exception(&quot;Missing or empty values in &quot; &amp; in_ConfigFile &amp; &quot;: &quot; &amp; missingKeys)]" />
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log – Settings loaded" Level="Info" Message="[&quot;Loaded &quot; &amp; out_Config.Count.ToString &amp; &quot; settings and assets from &quot; &amp; in_ConfigFile &amp; &quot;.&quot;]" />
  </Sequence>
</Activity>
