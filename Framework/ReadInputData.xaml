  <Sequence DisplayName="ReadInputData" sap2010:Annotation.AnnotationText="Downloads the input spreadsheet to a unique temp file, reads the products and markets sheets, keeps only products that are checked in the first column and have a valid quantity, and deletes the temp file. Fails clearly when columns are missing or nothing is selected.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputFilePath" />
      <Variable x:TypeArguments="sdata:DataTable" Name="allProducts" />
      <Variable x:TypeArguments="sdata:DataTable" Name="allMarkets" />
      <Variable x:TypeArguments="x:String" Name="itemColumn" />
      <Variable x:TypeArguments="x:String" Name="amountColumn" />
      <Variable x:TypeArguments="x:String" Name="marketColumn" />
    </Sequence.Variables>
    <Assign DisplayName="Assign – Temp file path">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[inputFilePath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Path.Combine(Path.GetTempPath(), "ComparePrices_" &amp; Now.ToString("yyyyMMdd_HHmmss") &amp; ".xlsx")]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign – Item column">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[itemColumn]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_Config("ProductsItemColumn").ToString]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign – Quantity column">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[amountColumn]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_Config("ProductsAmountColumn").ToString]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign – Market column">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[marketColumn]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_Config("MarketsMarketColumn").ToString]</InArgument>
      </Assign.Value>
    </Assign>
    <TryCatch DisplayName="Try – Read input sheet">
      <TryCatch.Try>
        <Sequence DisplayName="Download and read">
          <uasf:DownloadFileFromUrl ResponseAttachment="{x:Null}" Timeout="{x:Null}" UserAgentHeader="{x:Null}" ConflictResolution="[UiPath.Activities.System.FileOperations.FileConflictBehavior.Replace]" DisplayName="Download – Input sheet" FileName="[inputFilePath]" sap:VirtualizedContainerService.HintSize="745.6,122.4" sap2010:WorkflowViewState.IdRef="DownloadFileFromUrl_2" Url="[in_Config(&quot;SheetURL&quot;).ToString]" />
          <ui:ReadRange AddHeaders="True" DataTable="[allProducts]" DisplayName="Read – Products sheet" Range="[in_Config(&quot;ProductsSheetRange&quot;).ToString]" SheetName="[in_Config(&quot;ProductsSheetName&quot;).ToString]" WorkbookPath="[inputFilePath]">
            <ui:ReadRange.Password>
              <InArgument x:TypeArguments="x:String" />
            </ui:ReadRange.Password>
          </ui:ReadRange>
          <ui:ReadRange AddHeaders="True" DataTable="[allMarkets]" DisplayName="Read – Markets sheet" Range="[in_Config(&quot;MarketsSheetRange&quot;).ToString]" SheetName="[in_Config(&quot;MarketsSheetName&quot;).ToString]" WorkbookPath="[inputFilePath]">
            <ui:ReadRange.Password>
              <InArgument x:TypeArguments="x:String" />
            </ui:ReadRange.Password>
          </ui:ReadRange>
          <If Condition="[Not allProducts.Columns.Contains(itemColumn) OrElse Not allProducts.Columns.Contains(amountColumn)]" DisplayName="If – Product columns are missing">
            <If.Then>
              <Sequence DisplayName="Then">
                <Throw DisplayName="Throw – Product columns missing" Exception="[New Exception(&quot;Sheet '&quot; &amp; in_Config(&quot;ProductsSheetName&quot;).ToString &amp; &quot;' must have the columns '&quot; &amp; itemColumn &amp; &quot;' and '&quot; &amp; amountColumn &amp; &quot;'.&quot;)]" />
              </Sequence>
            </If.Then>
          </If>
          <If Condition="[Not allMarkets.Columns.Contains(marketColumn)]" DisplayName="If – Market column is missing">
            <If.Then>
              <Sequence DisplayName="Then">
                <Throw DisplayName="Throw – Market column missing" Exception="[New Exception(&quot;Sheet '&quot; &amp; in_Config(&quot;MarketsSheetName&quot;).ToString &amp; &quot;' must have the column '&quot; &amp; marketColumn &amp; &quot;'.&quot;)]" />
              </Sequence>
            </If.Then>
          </If>
          <Assign DisplayName="Assign – Empty selected products table">
            <Assign.To>
              <OutArgument x:TypeArguments="sdata:DataTable">[out_ProductsDataTable]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sdata:DataTable">[allProducts.Clone()]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[allProducts]" DisplayName="For Each Product Row">
            <ui:ForEachRow.Body>
              <ActivityAction x:TypeArguments="sdata:DataRow">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="sdata:DataRow" Name="row" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Validate row">
                  <Sequence.Variables>
                    <Variable x:TypeArguments="x:String" Name="itemName" />
                    <Variable x:TypeArguments="x:String" Name="amountText" />
                    <Variable x:TypeArguments="x:Boolean" Name="isChecked" />
                  </Sequence.Variables>
                  <Assign DisplayName="Assign – Item name">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[itemName]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[row(itemColumn).ToString.Trim]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign – Quantity text">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[amountText]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[row(amountColumn).ToString.Trim]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign – Checkbox in first column">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Boolean">[isChecked]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Boolean">[{"true", "verdadeiro", "1"}.Contains(Convert.ToString(row(0)).Trim.ToLowerInvariant())]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <If Condition="[isChecked AndAlso Not String.IsNullOrWhiteSpace(amountText)]" DisplayName="If – Row is checked and has a quantity">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <If Condition="[String.IsNullOrWhiteSpace(itemName)]" DisplayName="If – Item name is empty">
                          <If.Then>
                            <Sequence DisplayName="Then">
                              <ui:LogMessage DisplayName="Log – Row without item" Level="Warn" Message="[&quot;Row skipped: quantity '&quot; &amp; amountText &amp; &quot;' has no item name.&quot;]" />
                            </Sequence>
                          </If.Then>
                          <If.Else>
                            <Sequence DisplayName="Else">
                              <If Condition="[System.Text.RegularExpressions.Regex.IsMatch(amountText, &quot;^\d+([.,]0+)?$&quot;) AndAlso CInt(Decimal.Parse(amountText.Replace(&quot;,&quot;, &quot;.&quot;), System.Globalization.CultureInfo.InvariantCulture)) &gt; 0]" DisplayName="If – Quantity is a whole number above 0">
                                <If.Then>
                                  <Sequence DisplayName="Then">
                                    <Assign DisplayName="Assign – Normalized quantity">
                                      <Assign.To>
                                        <OutArgument x:TypeArguments="x:Object">[row(amountColumn)]</OutArgument>
                                      </Assign.To>
                                      <Assign.Value>
                                        <InArgument x:TypeArguments="x:Object">[CInt(Decimal.Parse(amountText.Replace(",", "."), System.Globalization.CultureInfo.InvariantCulture))]</InArgument>
                                      </Assign.Value>
                                    </Assign>
                                    <InvokeMethod DisplayName="Invoke – Add row to selected products" MethodName="ImportRow">
                                      <InvokeMethod.TargetObject>
                                        <InArgument x:TypeArguments="sdata:DataTable">[out_ProductsDataTable]</InArgument>
                                      </InvokeMethod.TargetObject>
                                      <InArgument x:TypeArguments="sdata:DataRow">[row]</InArgument>
                                    </InvokeMethod>
                                  </Sequence>
                                </If.Then>
                                <If.Else>
                                  <Sequence DisplayName="Else">
                                    <ui:LogMessage DisplayName="Log – Invalid quantity" Level="Warn" Message="[&quot;Row skipped: item '&quot; &amp; itemName &amp; &quot;' has an invalid quantity '&quot; &amp; amountText &amp; &quot;' (expected a whole number above 0).&quot;]" />
                                  </Sequence>
                                </If.Else>
                              </If>
                            </Sequence>
                          </If.Else>
                        </If>
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Sequence DisplayName="Else">
                        <If Condition="[isChecked]" DisplayName="If – Checked without quantity">
                          <If.Then>
                            <Sequence DisplayName="Then">
                              <ui:LogMessage DisplayName="Log – Checked without quantity" Level="Warn" Message="[&quot;Row skipped: item '&quot; &amp; itemName &amp; &quot;' is checked but has no quantity.&quot;]" />
                            </Sequence>
                          </If.Then>
                        </If>
                      </Sequence>
                    </If.Else>
                  </If>
                </Sequence>
              </ActivityAction>
            </ui:ForEachRow.Body>
          </ui:ForEachRow>
          <If Condition="[out_ProductsDataTable.Rows.Count = 0]" DisplayName="If – No product selected">
            <If.Then>
              <Sequence DisplayName="Then">
                <Throw DisplayName="Throw – No product selected" Exception="[New Exception(&quot;No product selected: check the first column and fill the '&quot; &amp; amountColumn &amp; &quot;' column in sheet '&quot; &amp; in_Config(&quot;ProductsSheetName&quot;).ToString &amp; &quot;'.&quot;)]" />
              </Sequence>
            </If.Then>
          </If>
          <If Condition="[allMarkets.AsEnumerable().Count(Function(r) Not String.IsNullOrWhiteSpace(r(marketColumn).ToString)) = 0]" DisplayName="If – No market listed">
            <If.Then>
              <Sequence DisplayName="Then">
                <Throw DisplayName="Throw – No market listed" Exception="[New Exception(&quot;No market listed in sheet '&quot; &amp; in_Config(&quot;MarketsSheetName&quot;).ToString &amp; &quot;'.&quot;)]" />
              </Sequence>
            </If.Then>
          </If>
          <Assign DisplayName="Assign – Markets without empty rows">
            <Assign.To>
              <OutArgument x:TypeArguments="sdata:DataTable">[out_MarketsDataTable]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sdata:DataTable">[allMarkets.AsEnumerable().Where(Function(r) Not String.IsNullOrWhiteSpace(r(marketColumn).ToString)).CopyToDataTable()]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log – Input summary" Level="Info" Message="[out_ProductsDataTable.Rows.Count.ToString &amp; &quot; product(s) selected, &quot; &amp; out_MarketsDataTable.Rows.Count.ToString &amp; &quot; market(s) to compare.&quot;]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Finally>
        <Sequence DisplayName="Finally – Delete downloaded file">
          <InvokeMethod DisplayName="Invoke – Delete temp file" MethodName="Delete" TargetType="sio:File">
            <InArgument x:TypeArguments="x:String">[inputFilePath]</InArgument>
          </InvokeMethod>
        </Sequence>
      </TryCatch.Finally>
    </TryCatch>
  </Sequence>
</Activity>
